# 环境变量（变量名与 Python 版 Claude-Code-simple 一致，ADR-0005）
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

OPENAI_FALLBACK_MODEL 未用——Python 代码读 FALLBACK_MODEL_ID
# 可选
FALLBACK_MODEL_ID=                       # 429/529 连续失败时切换的备用模型
OPENAI_TOOL_STRICT=true                  # 工具调用 strict 模式（"false" 关闭）
TAVILY_API_KEY=                          # tavily_search 工具
