{
  "name": "claude-pi",
  "version": "0.1.0",
  "description": "类 Claude Code 架构的 TypeScript Agent 运行时（移植自 Claude-Code-simple）",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test -- --maxWorkers=2",
    "eval:reliability": "node scripts/reliability-eval.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "eval:coding-smoke": "node scripts/coding-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "dotenv": "16.6.1",
    "glob": "^13.0.6",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.23.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "bin": {
    "cpi": "bin/cpi.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "examples",
    "docs",
    "CONTEXT.md",
    "README.md",
    "PLAN.md",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.18"
  }
}
